FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      cpSurfaces;
}

functions
{
    cpSurfaces
    {
        type                surfaces;
        libs                (sampling);
        writeControl        writeTime;
        interpolationScheme cell;
        surfaceFormat       vtk;
        fields              (p);

        surfaces
        {
            aircraft
            {
                type        patch;
                patches     (aircraft);
                interpolate true;
            }
        }
    }
}
